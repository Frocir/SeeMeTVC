# SeeMeTVC 公共环境变量
# 复制为仓库根目录 .env 后，后端 / Vite / docker compose 共用。
# 不要提交 .env。上游视频 / LLM Key 只写在超管渠道表，不放这里。
# 下面口令与钥匙仅供本机示例；源码里没有同样的默认值。

# --- 本机地址（开发代理、端口映射）---
# 浏览器不读这两项；Vite 进程用它们拼开发代理。局域网访问请保持 API 在本机。
API_HOST=127.0.0.1
API_PORT=8000
WEB_HOST=true
WEB_PORT=5173

# 分域部署时给浏览器的 API 根（空 = 同源 /api，走 Vite 代理或 nginx）
VITE_API_BASE=
# 一般不用单独设；留空则等于 http://$API_HOST:$API_PORT
VITE_API_PROXY=

# --- 后端 ---
DATABASE_URL=sqlite+aiosqlite:///./seemetvc.db
# 本机 python 可留空：首次启动会写入 backend/data/.jwt_secret（已 gitignore）
# docker compose 必须非空
JWT_SECRET=dev-secret-change-me
CORS_ORIGINS=*
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# 至少 6 位才会创建超管；空则跳过。docker compose 必须非空
BOOTSTRAP_ADMIN_PASSWORD=admin123456
BALANCE_UNIT_LABEL=积分
MAX_PARALLEL_JOBS=3
UPLOAD_DIR=./data/uploads
FFMPEG_PATH=
# 烧字幕字体；空则用 %WINDIR%\Fonts（微软雅黑/Arial）或 Linux 常见 Noto/文泉驿/DejaVu
SUBTITLE_FONT=
PUBLIC_API_BASE_URL=
PUBLIC_ASSET_BASE_URL=
AGNES_BASE_URL=https://api.agnes-ai.cn
AGNES_UPSTREAM_MODEL=agnes-video-v2.0
AGNES_MIN_GAP_SEC=8
AGNES_429_BASE_SLEEP_SEC=25
LOCAL_PROXY_HOST=127.0.0.1

# --- aisrv（本机 Edge TTS，OpenAI /v1/audio/speech 兼容）---
# compose 会再起一个容器；本地 python 开发请另开，API_KEY 与下面一致：
# docker run -d -p 5050:5050 -e API_KEY=<与 AISRV_API_KEY 相同> -e DEFAULT_VOICE=zh-CN-XiaoxiaoNeural travisvn/openai-edge-tts:latest
# 本机 python aisrv 若留空则不校验 Bearer；docker compose 必须非空
AISRV_API_KEY=seemetvc-aisrv-dev-key
AISRV_PORT=5050
# 留空 = http://$LOCAL_PROXY_HOST:$AISRV_PORT；compose 内请设 http://aisrv:5050
AISRV_BASE_URL=

# 可选：向量引擎 Gemini 文生图。启动时写入「向量引擎 · Gemini 文生图」渠道并启用。
# VECTORENGINE_API_KEY=

# 开发登录页是否预填超管（仅当上面 BOOTSTRAP_ADMIN_* 都有值；生产构建永远不预填）
DEV_PREFILL_LOGIN=true

# --- Docker Compose（本地 python 不用 Postgres）---
POSTGRES_USER=seeme
POSTGRES_PASSWORD=seeme
POSTGRES_DB=seemetvc
POSTGRES_PORT=5432
