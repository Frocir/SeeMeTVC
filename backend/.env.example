# SeeMeTVC local env example — copy to backend/.env or project root .env

# Optional: Agnes AI free-tier key (Pavo / agnes-video-v2.0 protocol)
# Open-source Agnes projects do not publish shared trial tokens.
# Register a free key: https://platform.agnes-ai.com/settings/apiKeys
AGNES_API_KEY=
# China site (recommended for domestic keys):
AGNES_BASE_URL=https://api.agnes-ai.cn
# International alternatives:
# AGNES_BASE_URL=https://apihub.agnes-ai.com
# AGNES_BASE_URL=https://apihub.agnes-ai.cn
AGNES_UPSTREAM_MODEL=agnes-video-v2.0

# Local reference-image uploads (default ./data/uploads under backend cwd)
# UPLOAD_DIR=./data/uploads
# Used when backend inlines relative /beauty assets for Agnes (default Vite)
# PUBLIC_ASSET_BASE_URL=http://127.0.0.1:5173
